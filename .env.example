OPENAI_API_KEY=
# Organization Admin API key, required only for the usage/cost report.
OPENAI_ADMIN_KEY=
# Optional: restrict the usage/cost report to one OpenAI project.
OPENAI_PROJECT_ID=
OPENAI_IMAGE_MODEL=gpt-image-2
# Optional: blank uses the current USD rate from the National Bank of Ukraine.
USD_TO_UAH=
# Meta Page access tokens (server only; keep values in the ignored local .env).
META_MESSENGER_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_GRAPH_API_VERSION=v27.0
META_API_PASSWORD=
META_APP_ORIGIN=
PORT=3001
